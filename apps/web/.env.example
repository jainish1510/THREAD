# Where the Next.js server proxies /api/* (the FastAPI service).
API_INTERNAL_URL=http://localhost:8000
# Public base URL of this site (used for metadata and OAuth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional — enables Stripe Elements. Without it, checkout runs in clearly-labelled test mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
