# Copy to .env (in this folder) to override defaults. Every value is optional.

# Database — SQLite file by default. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://thread:thread@localhost:5432/thread
DATABASE_URL=sqlite:///./thread.db

# Redis — enables cross-instance live events and shared rate limits. Leave empty to run in-process.
REDIS_URL=

# The web app's origin (CORS) and public URL (OAuth redirects).
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# Admin account created on first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=thread-admin-2026

# Generate 180 days of simulated orders for the admin analytics.
SEED_DEMO_HISTORY=true

# Stripe — leave empty for built-in test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google sign-in — leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production: set ENVIRONMENT=production and COOKIE_SECURE=true behind HTTPS.
ENVIRONMENT=development
COOKIE_SECURE=false
